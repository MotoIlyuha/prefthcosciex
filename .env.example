# ---------------------------------------------------------------------------
# «Байт» — пример окружения. Скопируйте в `.env` и заполните.
# Настоящий .env НИКОГДА не коммитится. На стенде его пишет infra/deploy-stage.sh:
# пароли и токены генерируются на сервере (openssl rand), а токен бота и SSH‑доступ
# приходят из секретов GitHub Actions.
# ---------------------------------------------------------------------------

# --- Общее ------------------------------------------------------------------
# local | test | stage | prod. На stage/prod API отказывается стартовать с dev-секретами.
BAYT_ENV=local
# Публичный адрес Mini App и вебхука бота (без слеша в конце).
PUBLIC_BASE_URL=http://localhost:8080
# Подпись JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Access 15 минут, refresh 30 дней (дизайн‑док 12.3).
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# POST /api/auth/dev для локальных e2e. На stage/prod игнорируется всегда.
DEV_LOGIN=false

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=bayt
# openssl rand -hex 24
POSTGRES_PASSWORD=bayt
POSTGRES_DB=bayt
DATABASE_URL=postgresql+asyncpg://bayt:bayt@postgres:5432/bayt

# --- Redis (кэш, лимиты, очередь ARQ) ----------------------------------------
# openssl rand -hex 24
REDIS_PASSWORD=bayt
REDIS_URL=redis://:bayt@redis:6379/0

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather: проверка initData (HMAC) и отправка сообщений.
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например bayt_ege_bot.
TELEGRAM_BOT_USERNAME=
# Короткое имя Mini App в BotFather (/newapp): ссылки t.me/<bot>/<app>?startapp=...
TELEGRAM_APP_SHORT_NAME=app
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token для вебхука. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# initData старше 10 минут не принимается (12.3).
TELEGRAM_INITDATA_MAX_AGE=600
# webhook (стенд) | polling (локально, без публичного адреса)
BOT_MODE=polling
BOT_API_URL=http://api:8000/api
# Общий секрет бота и /api/internal. openssl rand -hex 32
INTERNAL_TOKEN=dev-internal-token

# --- Раннер кода (nsjail) ----------------------------------------------------
RUNNER_URL=http://runner:8081
# Общий токен api/worker ↔ runner. openssl rand -hex 32
RUNNER_TOKEN=dev-runner-token
# Сколько программ одновременно (по умолчанию — число ядер).
RUNNER_CONCURRENCY=4

# --- S3 (SeaweedFS: ассеты экземпляров и бэкапы) ----------------------------------------
# Пусто — файлы в /tmp/bayt-assets внутри контейнера (только для разработки).
S3_ENDPOINT=http://s3:8333
S3_BUCKET=bayt
S3_ACCESS_KEY=bayt
# openssl rand -hex 24
S3_SECRET_KEY=bayt-s3-secret
S3_REGION=us-east-1

# --- Аналитика --------------------------------------------------------------
# Необязательно. Пусто — события пишутся в таблицу events (без ПДн).
POSTHOG_KEY=
POSTHOG_HOST=

# --- Администраторы ---------------------------------------------------------
# Telegram ID через запятую. Пусто — админом становится первый вошедший.
ADMIN_TELEGRAM_IDS=

# --- Лимиты (12.6) ----------------------------------------------------------
RATE_LIMIT_ANSWERS_PER_MIN=60
RATE_LIMIT_RUNS_PER_HOUR=20
RATE_LIMIT_DEFAULT_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=30

# --- Стенд (читает только infra/deploy-stage.sh, не приложение) ---------------
# Домен с A‑записью на сервер; пусто — <ip>.sslip.io.
STAGE_DOMAIN=
STAGE_SITE_ADDRESS=:80
