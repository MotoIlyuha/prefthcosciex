# ---------------------------------------------------------------------------
# Bayt — example environment. Copy to `.env` and fill in.
# NEVER commit a real .env. Secrets live on the server and in GH Actions.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Environment name: local | stage | prod. Controls CSP strictness and docs exposure.
BAYT_ENV=local
# Public base URL the Mini App and bot webhook are served from (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080
# Symmetric secret for signing access/refresh JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
# Access token lifetime (minutes) and refresh token lifetime (days).
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=bayt
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bayt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full async SQLAlchemy DSN. Derived from the parts above in compose.
DATABASE_URL=postgresql+asyncpg://bayt:change-me@postgres:5432/bayt

# --- Redis (cache + ARQ queue) ---------------------------------------------
# Generate: openssl rand -base64 24
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. Used for initData HMAC verification AND sending.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. bayt_ege_bot. Used for deep links and Mini App URL.
TELEGRAM_BOT_USERNAME=
# Random secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token on webhook.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Max age (seconds) accepted for initData auth_date. 86400 = 24h.
TELEGRAM_INITDATA_MAX_AGE=86400

# --- Code runner (nsjail sandbox service) -----------------------------------
RUNNER_URL=http://runner:8081
# Shared bearer token between api/worker and the runner. openssl rand -hex 32
RUNNER_TOKEN=change-me
# Hard limits enforced inside the jail.
RUNNER_CPU_SECONDS=5
RUNNER_WALL_SECONDS=10
RUNNER_MEMORY_MB=256
RUNNER_MAX_OUTPUT_BYTES=65536

# --- S3 / MinIO -------------------------------------------------------------
# Leave S3_ENDPOINT empty to use the MinIO service from compose.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bayt
S3_ACCESS_KEY=bayt
# Generate: openssl rand -base64 24
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
# Public URL prefix used in signed links handed to the client.
S3_PUBLIC_URL=http://localhost:8080/s3

# --- Analytics --------------------------------------------------------------
# Optional. If empty, events are written to the `events` table only.
POSTHOG_KEY=
POSTHOG_HOST=

# --- Admin ------------------------------------------------------------------
# Comma-separated Telegram user IDs with the admin role.
# If empty, the FIRST user who authenticates is promoted to admin (bootstrap).
ADMIN_TELEGRAM_IDS=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ANSWER=30/minute
RATE_LIMIT_RUN_CODE=10/minute

# --- Stage deploy (used by infra/deploy-stage.sh, never read by the app) -----
STAGE_SSH_HOST=
STAGE_SSH_USER=root
STAGE_SSH_KEY_PATH=
# Domain pointing at the VPS. If empty, deploy uses <ip>.sslip.io.
STAGE_DOMAIN=
